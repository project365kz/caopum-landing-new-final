# SPA fallback для Plesk/Apache.
# Любой URL, не указывающий на существующий файл/папку, отдаёт index.html —
# чтобы клиентский роутинг (/en, /en/...) работал без 404.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Не трогаем существующие файлы и директории
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Всё остальное — на index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Принудительный HTTPS
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# Кэширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML не кэшируем — чтобы изменения деплоились сразу
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
